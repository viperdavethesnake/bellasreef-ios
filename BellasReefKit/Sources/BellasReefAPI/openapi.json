{
  "components": {
    "schemas": {
      "AccessToken": {
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "AccessToken",
        "type": "object"
      },
      "ActuatorState": {
        "additionalProperties": false,
        "description": "Last-known state of one actuator, published after every transition.",
        "properties": {
          "actuator_id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Actuator Id",
            "type": "string"
          },
          "emitted_at": {
            "format": "date-time",
            "title": "Emitted At",
            "type": "string"
          },
          "latched": {
            "default": false,
            "title": "Latched",
            "type": "boolean"
          },
          "level": {
            "discriminator": {
              "mapping": {
                "binary": "#/components/schemas/BinaryLevel",
                "pwm": "#/components/schemas/PwmLevel"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/BinaryLevel"
              },
              {
                "$ref": "#/components/schemas/PwmLevel"
              }
            ],
            "title": "Level"
          },
          "message_id": {
            "format": "uuid",
            "title": "Message Id",
            "type": "string"
          },
          "reason": {
            "enum": [
              "commanded",
              "safe_state",
              "interlock_latch",
              "manual_override",
              "startup"
            ],
            "title": "Reason",
            "type": "string"
          },
          "schema_version": {
            "const": 2,
            "default": 2,
            "title": "Schema Version",
            "type": "integer"
          },
          "since": {
            "format": "date-time",
            "title": "Since",
            "type": "string"
          },
          "source": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "emitted_at",
          "source",
          "actuator_id",
          "level",
          "reason",
          "since"
        ],
        "title": "ActuatorState",
        "type": "object"
      },
      "BinaryLevel": {
        "additionalProperties": false,
        "description": "An on/off actuator level \u2014 relays, outlets, solenoids.",
        "properties": {
          "kind": {
            "const": "binary",
            "default": "binary",
            "title": "Kind",
            "type": "string"
          },
          "on": {
            "title": "On",
            "type": "boolean"
          }
        },
        "required": [
          "on"
        ],
        "title": "BinaryLevel",
        "type": "object"
      },
      "Client": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_seen_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "revoked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "last_seen_at",
          "revoked_at"
        ],
        "title": "Client",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Info": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "contracts_version": {
            "title": "Contracts Version",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "paired_client_count": {
            "title": "Paired Client Count",
            "type": "integer"
          },
          "pairing_open": {
            "title": "Pairing Open",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "api_version",
          "contracts_version",
          "paired_client_count",
          "pairing_open"
        ],
        "title": "Info",
        "type": "object"
      },
      "OverrideContext": {
        "additionalProperties": false,
        "description": "The active manual hold on an actuator, if any.\n\nCarried on every state frame because the time-and-scheduling contract\nrequires override state to be loudly visible: a client showing a channel at\n0% must be able to say whether that is the schedule or a hold, and when the\nhold ends.",
        "properties": {
          "duty": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Duty",
            "type": "number"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "expires_in_s": {
            "minimum": 0.0,
            "title": "Expires In S",
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "duty",
          "expires_at",
          "expires_in_s"
        ],
        "title": "OverrideContext",
        "type": "object"
      },
      "OverrideRequest": {
        "additionalProperties": false,
        "properties": {
          "duration_s": {
            "exclusiveMinimum": 0.0,
            "maximum": 86400.0,
            "title": "Duration S",
            "type": "number"
          },
          "duty": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Duty",
            "type": "number"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "target": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "target",
          "duty",
          "duration_s"
        ],
        "title": "OverrideRequest",
        "type": "object"
      },
      "OverrideView": {
        "additionalProperties": false,
        "properties": {
          "duty": {
            "title": "Duty",
            "type": "number"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "expires_in_s": {
            "title": "Expires In S",
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "id",
          "target",
          "duty",
          "expires_at",
          "expires_in_s"
        ],
        "title": "OverrideView",
        "type": "object"
      },
      "PairGranted": {
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "format": "uuid",
            "title": "Client Id",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token",
          "client_id"
        ],
        "title": "PairGranted",
        "type": "object"
      },
      "PairPending": {
        "additionalProperties": false,
        "properties": {
          "expires_in_s": {
            "title": "Expires In S",
            "type": "integer"
          },
          "poll_after_s": {
            "title": "Poll After S",
            "type": "integer"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "poll_after_s",
          "expires_in_s"
        ],
        "title": "PairPending",
        "type": "object"
      },
      "PairRequest": {
        "additionalProperties": false,
        "properties": {
          "client_name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Name",
            "type": "string"
          }
        },
        "required": [
          "client_name"
        ],
        "title": "PairRequest",
        "type": "object"
      },
      "PwmLevel": {
        "additionalProperties": false,
        "description": "A proportional level, normalised 0.0\u20131.0 \u2014 LED channels, variable pumps.\n\nNormalised deliberately: the contract must not leak a driver's native\nresolution (PCA9685 is 12-bit) to the control engine.",
        "properties": {
          "duty": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Duty",
            "type": "number"
          },
          "kind": {
            "const": "pwm",
            "default": "pwm",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "duty"
        ],
        "title": "PwmLevel",
        "type": "object"
      },
      "ReadyFrame": {
        "additionalProperties": false,
        "description": "Sent once, after the socket authenticates. Nothing precedes it.",
        "properties": {
          "client_id": {
            "format": "uuid",
            "title": "Client Id",
            "type": "string"
          },
          "frame_version": {
            "const": 1,
            "default": 1,
            "title": "Frame Version",
            "type": "integer"
          },
          "kind": {
            "const": "ready",
            "default": "ready",
            "title": "Kind",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          }
        },
        "required": [
          "received_at",
          "client_id"
        ],
        "title": "ReadyFrame",
        "type": "object"
      },
      "SensorFrame": {
        "additionalProperties": false,
        "description": "A sensor reading, forwarded unchanged.",
        "properties": {
          "frame_version": {
            "const": 1,
            "default": 1,
            "title": "Frame Version",
            "type": "integer"
          },
          "kind": {
            "const": "sensor",
            "default": "sensor",
            "title": "Kind",
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/SensorReading"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "received_at",
          "subject",
          "payload"
        ],
        "title": "SensorFrame",
        "type": "object"
      },
      "SensorReading": {
        "additionalProperties": false,
        "description": "One sample from one sensor.\n\nPublished on ``bellasreef.sensor.<type>.<id>`` as core pub/sub. History\nlives in VictoriaMetrics, so these are deliberately not persisted on the\nspine.",
        "properties": {
          "calibration_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calibration Id"
          },
          "emitted_at": {
            "format": "date-time",
            "title": "Emitted At",
            "type": "string"
          },
          "message_id": {
            "format": "uuid",
            "title": "Message Id",
            "type": "string"
          },
          "quality": {
            "default": "ok",
            "enum": [
              "ok",
              "stale",
              "fault"
            ],
            "title": "Quality",
            "type": "string"
          },
          "schema_version": {
            "const": 2,
            "default": 2,
            "title": "Schema Version",
            "type": "integer"
          },
          "sensor_id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Sensor Id",
            "type": "string"
          },
          "sensor_type": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Sensor Type",
            "type": "string"
          },
          "source": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Source",
            "type": "string"
          },
          "unit": {
            "maxLength": 16,
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "message_id",
          "emitted_at",
          "source",
          "sensor_id",
          "sensor_type",
          "value",
          "unit"
        ],
        "title": "SensorReading",
        "type": "object"
      },
      "StateFrame": {
        "additionalProperties": false,
        "description": "An actuator state, plus the override context the spine cannot supply.",
        "properties": {
          "frame_version": {
            "const": 1,
            "default": 1,
            "title": "Frame Version",
            "type": "integer"
          },
          "kind": {
            "const": "state",
            "default": "state",
            "title": "Kind",
            "type": "string"
          },
          "override": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OverrideContext"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "payload": {
            "$ref": "#/components/schemas/ActuatorState"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "received_at",
          "subject",
          "payload"
        ],
        "title": "StateFrame",
        "type": "object"
      },
      "TokenRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "TokenRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Reef controller: pairing, auth, and device control.",
    "title": "Bella's Reef API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/clients": {
      "get": {
        "operationId": "listClients",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Client"
                  },
                  "title": "Response Listclients",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Clients",
        "tags": [
          "clients"
        ]
      }
    },
    "/api/v1/clients/{client_id}": {
      "delete": {
        "description": "Revoke. Any paired client may revoke any other, including itself.\n\nauth.md \u00a71: revocation is the only privilege operation and a paired\ndevice has full operator rights. A lost phone is revoked from the one\nyou still have.",
        "operationId": "revokeClient",
        "parameters": [
          {
            "in": "path",
            "name": "client_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Client Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Revokeclient",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke Client",
        "tags": [
          "clients"
        ]
      }
    },
    "/api/v1/devices": {
      "get": {
        "description": "Registered hardware. *Devices* are the tank's; clients are people's.",
        "operationId": "listDevices",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Listdevices",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Devices",
        "tags": [
          "hardware"
        ]
      }
    },
    "/api/v1/info": {
      "get": {
        "description": "Renders the connect screen before any commitment.\n\nUnauthenticated by design, and returns nothing sensitive: a name, two\nversion strings, and whether pairing is open.",
        "operationId": "info",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Info",
        "tags": [
          "discovery"
        ]
      }
    },
    "/api/v1/overrides": {
      "get": {
        "operationId": "listOverrides",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OverrideView"
                  },
                  "title": "Response Listoverrides",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Overrides",
        "tags": [
          "overrides"
        ]
      },
      "post": {
        "description": "Hold a target at a level for a duration.\n\nClock-gated: an override IS a deadline, and one computed from a clock\nchrony is about to step is not the duration the operator asked for.",
        "operationId": "createOverride",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OverrideRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverrideView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Clock not synchronised; deadline would be wrong."
          }
        },
        "summary": "Create Override",
        "tags": [
          "overrides"
        ]
      }
    },
    "/api/v1/overrides/{override_id}": {
      "delete": {
        "operationId": "releaseOverride",
        "parameters": [
          {
            "in": "path",
            "name": "override_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Override Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {

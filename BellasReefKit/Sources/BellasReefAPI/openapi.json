    "/api/v1/pair": {
      "post": {
        "description": "Pair a client. Four outcomes, in this order.\n\n1. No client has ever paired -> TOFU grant, and the window shuts.\n2. A recovery window is open -> grant and spend it.\n3. Someone is alive to approve -> 202, poll for a decision.\n4. Clients exist but every one is revoked -> 403. There is nobody to\n   approve, so the honest answer is to tell the operator to run\n   `bellasreef pair` on the hub rather than leave them polling a\n   request no one will ever see.",
        "operationId": "pair",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairGranted"
                }
              }
            },
            "description": "Paired; credential issued."
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairPending"
                }
              }
            },
            "description": "Awaiting approval; poll."
          },
          "403": {
            "description": "Nobody can approve; run `bellasreef pair`."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Pair",
        "tags": [
          "pairing"
        ]
      }
    },
    "/api/v1/pair/{request_id}": {
      "get": {
        "operationId": "pollPairing",

          "403": {
            "description": "Denied."
          },
          "404": {
            "description": "No such request."
          },
          "410": {
            "description": "Expired, or the credential was already collected."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Poll Pair",
        "tags": [
          "pairing"
        ]
      }
    },
